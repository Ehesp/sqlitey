{
  "name": "sqlitey",
  "version": "0.3.1",
  "description": "sqlitey — local SQLite database UI (@tursodatabase/database) with Bun",
  "private": true,
  "type": "module",
  "bin": {
    "sqlitey": "src/index.ts"
  },
  "scripts": {
    "compile:local": "bun scripts/build-standalone-local.ts",
    "postinstall": "bun scripts/sync-turso-node-artifact.ts",
    "dev": "bun --hot src/index.ts --no-open ./app.db",
    "start": "NODE_ENV=production bun src/index.ts --no-open ./app.db",
    "studio": "bun src/index.ts",
    "build": "bun run build.ts",
    "seed": "bun scripts/seed-50k.ts ./app.db",
    "dev:db": "bun scripts/dev-db.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@tursodatabase/database": "^0.5.3",
    "@uiw/react-codemirror": "^4.25.9",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "react-resizable-panels": "^4.9.0",
    "shadcn-presets": "^0.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  }
}
